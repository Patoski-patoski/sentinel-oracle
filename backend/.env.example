# Sentinel Oracle Backend Environment Variables
PORT=3000

# CognoDB (openCypher via Bolt protocol)
COGNO_DB_URI=bolt://localhost:7687
COGNO_DB_USER=neo4j
COGNO_DB_PASSWORD=password
COGNO_DB_DATABASE=neo4j

# Moove Agentic Payments Rails
# Leave MOOVE_API_KEY as 'mock' for local devnet sandbox mode
MOOVE_API_KEY=mock
MOOVE_API_BASE_URL=https://api.moove.xyz
MOOVE_RECIPIENT_HANDLE=sentinel.moove
MOOVE_TREASURY_ADDRESS=SentinelTreasurySolanaDevnetAddress11111111

# AI Reasoning Engine (Gemini free tier or OpenAI, fallback rule-engine active if not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
